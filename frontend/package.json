{
  "name": "zimpasta-gui",
  "private": true,
  "version": "0.2.0",
  "description": "The Dr. ZImpasta graphical interface (the View). Talks to the Python API in src/zimpasta/controller, or runs it in the browser (build:browser).",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "uv run zimpasta --gui --no-browser --port 8765",
    "dev:web": "vite",
    "build": "vite build",
    "build:browser": "node scripts/build-browser.mjs",
    "preview:browser": "vite preview --mode browser",
    "test:browser": "node scripts/test-browser.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "pyodide": "314.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "vite": "^8.3.1"
  }
}
